# STB-155 Agent Environment Configuration

# --- Solana Blockchain ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Isi dengan Base58 private key wallet burner agen, atau kosongkan jika ingin auto-generate
WALLET_PRIVATE_KEY=

# --- Twitter / X API (v2) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# --- LLM Brain (OpenAI / OpenRouter / DeepSeek / Groq) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# --- Agent Operation ---
# Interval antar tweet otomatis dalam detik (misal 7200 = 2 jam, 300 = 5 menit untuk tes)
TWEET_INTERVAL_SECONDS=7200
